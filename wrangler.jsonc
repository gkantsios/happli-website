{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // gohappli.com: Astro's static pages, plus a small Worker script for /api/* (the Marketing
  // waitlist). The name must match the Cloudflare project.
  "name": "happli-website",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    // Astro's build output (npm run build).
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only API requests run the Worker script; every page is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Per-IP limit on waitlist sign-ups: 5 a minute.
  "ratelimits": [
    {
      "name": "WAITLIST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
  // Secrets (set with `npx wrangler secret put NAME` or in the dashboard, never in this file):
  // TURNSTILE_SECRET_KEY, KIT_API_KEY, and optionally KIT_WAITLIST_TAG_ID. See the README.
}
