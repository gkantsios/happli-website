# Cloudflare Workers static assets: response headers for every page (read by Cloudflare, not served).
# The CSP's script hashes are filled in after `astro build` by scripts/csp-hashes.mjs, which hashes
# every inline <script> in dist/ (the build fails if this placeholder is missing).
# Everything loads from this site only, except:
# - Cloudflare Turnstile (the waitlist form's spam check on /pricing/): script and iframe from
#   https://challenges.cloudflare.com.
# - Umami analytics: script.js from, and events sent to, https://umami-production-42bf.up.railway.app.
# - Google Tag Manager (GTM-T3TTM9JP) and the GA4 tag configured inside it: gtm.js and gtag.js from
#   https://www.googletagmanager.com (plus its noscript iframe), hits sent to www.google-analytics.com
#   and region1.google-analytics.com. GTM "Custom HTML" tags need inline script and are blocked.
# No other third-party scripts, styles, fonts, frames or trackers.
# style-src allows inline styles: Astro inlines the page CSS and a few components set style="".
# font-src allows data: because the build inlines the smallest font subsets into that CSS.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://umami-production-42bf.up.railway.app https://www.googletagmanager.com {{INLINE_SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; font-src 'self' data:; connect-src 'self' https://umami-production-42bf.up.railway.app https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; manifest-src 'self'; frame-src https://challenges.cloudflare.com https://www.googletagmanager.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
