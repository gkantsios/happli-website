---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
}
const { title, description, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap prose-page legal">
    <article class="prose">
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .prose-page {
    padding-top: clamp(48px, 7vw, 88px);
  }
  .prose {
    margin: 0 auto;
  }
  /* phones: room below the text for the sticky "Book a demo" bar (StickyCta, 71px at 320) so it never covers the last line */
  @media (max-width: 699.98px) {
    .prose-page {
      padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
