---
// Client booking page on a phone (illustration). Used by the booking page feature card and /features.
// Scroll moment (public/motion/reveal.js): the days appear, Thursday is picked, the afternoon times
// drop in, the 1:15 pm opening (Dana's gap) is tapped and the booking confirms. The selections are
// overlays that fade in, so only opacity and transform animate. Without motion it shows the end.
---

<div class="phone" data-play>
  <div class="top"><div class="bb">gg</div><span class="studio">Golden Glow Studio</span></div>
  <p class="h">When suits <em>you?</em></p>
  <p class="svc">Custom spray tan · 30 min</p>
  <div class="days">
    <div class="day"><span>WED</span><b>26</b></div>
    <div class="day">
      <span>THU</span><b>27</b>
      <i class="sel"><span>THU</span><b>27</b></i>
    </div>
    <div class="day"><span>FRI</span><b>28</b></div>
    <div class="day off"><span>SAT</span><b>29</b></div>
  </div>
  <p class="lbl">AFTERNOON</p>
  <div class="slots">
    <div class="slot">
      1:15 pm<i class="sel">1:15 pm</i>
    </div>
    <div class="slot">2:00 pm</div>
    <div class="slot">3:30 pm</div>
  </div>
  <div class="foot">
    <div class="foot-was"><span>Deposit due today</span><b>Pay &amp; confirm</b></div>
    <p class="foot-now">Booked · confirmation sent</p>
  </div>
</div>

<style>
  .phone {
    width: 320px;
    max-width: 100%;
    background: #fff;
    border-radius: 34px;
    border: 1px solid var(--line-strong);
    box-shadow: 0 40px 80px -40px rgba(27, 22, 20, 0.35), 0 12px 28px -16px rgba(27, 22, 20, 0.14);
    padding: 22px 20px 18px;
    font-size: 13px;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .bb {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--blush);
    display: grid;
    place-items: center;
  }
  .studio {
    font-weight: 600;
  }
  .h {
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .h em {
    font-style: italic;
    color: var(--coral-ink);
  }
  .svc {
    color: var(--muted);
    margin-top: 6px;
    font-size: 12px;
  }
  .days {
    display: flex;
    gap: 8px;
    margin-top: 20px;
  }
  .day {
    flex: 1;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 8px 0;
    text-align: center;
    line-height: 1.2;
  }
  .day span {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .day b {
    display: block;
    font-size: 16px;
    font-weight: 600;
    margin-top: 3px;
  }
  .day,
  .slot {
    position: relative;
  }
  /* the picked day and time, drawn over the plain one */
  .sel {
    position: absolute;
    inset: -1px;
    display: grid;
    place-content: center;
    font-style: normal;
    border-radius: inherit;
  }
  .day .sel {
    background: var(--ink);
    color: #fff;
  }
  .day .sel span {
    color: rgba(255, 255, 255, 0.75);
  }
  .day.off {
    background: var(--bg);
    color: var(--muted);
  }
  .day.off b {
    text-decoration: line-through;
  }
  .lbl {
    margin-top: 20px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .slots {
    display: grid;
    gap: 8px;
    margin-top: 10px;
  }
  .slot {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 11px 0;
    text-align: center;
    font-weight: 600;
  }
  .slot .sel {
    background: var(--coral-strong);
    color: #fff;
  }
  .foot {
    display: grid;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-weight: 600;
  }
  /* before and after booking share one spot; the end state shows unless the sequence is playing */
  .foot > * {
    grid-area: 1 / 1;
  }
  .foot-was {
    display: flex;
    justify-content: space-between;
    align-items: center;
    opacity: 0;
  }
  .foot-was span {
    color: var(--muted);
    font-weight: 500;
  }
  .foot-now {
    justify-self: start;
    align-self: center;
    font-size: 12px;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: var(--sage);
    color: var(--sage-ink);
  }
</style>
