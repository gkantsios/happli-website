---
// Needs you list (illustration): an open gap and a waitlist match.
// interactive: real buttons and the data-* hooks for the walkthrough's script.
// Otherwise the buttons are drawn as plain labels (home feature card).
// app: the Needs you rail as the owner app draws it (cards with no buttons, same style as the
// hero's app screen), for /features.
interface Props {
  interactive?: boolean;
  app?: boolean;
}
const { interactive = false, app = false } = Astro.props;
const Btn = interactive ? 'button' : 'span';
---

{
  app && (
    <div class="app-needs" data-play>
      <p class="app-h">Needs you</p>
      <div class="app-card">
        <b>Gap offer · waiting for your approval</b>
        <span>Maria K. for Dana's 1:15 pm opening on Thursday.</span>
        <em>Review draft →</em>
      </div>
      <div class="app-card">
        <b>Dana · 1h gap</b>
        <span>1:15 pm – 2:15 pm is open.</span>
      </div>
      <div class="app-card">
        <b>Waitlist · Emma J. joined online</b>
        <span>Rapid tan on Sat, Aug 29, from the booking page. Book them when a time opens, or cancel the entry.</span>
        <em>Open in Waitlist →</em>
      </div>
    </div>
  )
}
{!app && (

<div class:list={['need', { static: !interactive }]} data-need={interactive ? '' : undefined} data-play={interactive ? undefined : ''}>
  {/* static copies: the rows slide in one after another as they scroll into view */}
  <div class="need-row">
    <div>
      <b>Open gap · Thu 1:15 – 2:15</b>
      <span>Dana has an hour free.</span>
    </div>
    <Btn type={interactive ? 'button' : undefined} class="mini" data-act={interactive ? 'gap' : undefined}>Draft an offer</Btn>
    <em class="done-tag">Offer drafted</em>
  </div>
  <div class="need-row">
    <div>
      <b>Waitlist match · Rapid tan</b>
      <span>Bea T. asked for Saturday morning · 10:00 is open.</span>
    </div>
    <div class="mini-pair">
      <Btn type={interactive ? 'button' : undefined} class="mini" data-act={interactive ? 'wl-book' : undefined}>Book</Btn>
      <Btn type={interactive ? 'button' : undefined} class="mini" data-act={interactive ? 'wl-dismiss' : undefined}>Dismiss</Btn>
    </div>
    <em class="done-tag" data-wl-tag={interactive ? '' : undefined}>Booked</em>
  </div>
  <p class="need-empty">Nothing else needs you. Enjoy your coffee.</p>
</div>
)}

<style>
  /* app variant: the owner app's Needs you cards (owner-desktop.css values) */
  .app-needs {
    display: flex;
    flex-direction: column;
    gap: 11px;
    margin: 12px 0 0;
    padding: 18px;
    border-radius: 12px;
    background: rgba(247, 228, 218, 0.35);
    text-align: left;
  }
  .app-h {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9b7a33;
    margin-bottom: -1px;
  }
  .app-card {
    display: flex;
    flex-direction: column;
    background: #fcf6f1;
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 2px 8px rgba(43, 27, 26, 0.05);
  }
  .app-card b {
    font-size: 13px;
    font-weight: 700;
    color: #2b1b1a;
  }
  .app-card span {
    font-size: 12.5px;
    font-weight: 500;
    color: #6b6a45;
    line-height: 1.5;
    margin-top: 4px;
  }
  .app-card em {
    font-style: normal;
    font-size: 12px;
    font-weight: 600;
    color: #f9727c;
    margin-top: 6px;
  }
  .mini {
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .need:not(.static) .mini:hover {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
  .static .mini {
    cursor: default;
  }
  .done-tag {
    display: none;
    font-style: normal;
    font-size: 12px;
    font-weight: 600;
    color: var(--sage-ink);
    background: var(--sage);
    padding: 5px 10px;
    border-radius: var(--radius-pill);
  }
  .need-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .need-row > div {
    flex: 1;
    min-width: 0;
  }
  .need-row b {
    display: block;
    font-weight: 600;
  }
  /* the row's description (not the button labels, which are spans when not interactive) */
  .need-row > div:first-child span {
    display: block;
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }
  .need-row > .mini-pair {
    flex: none;
    display: flex;
    gap: 6px;
  }
  .need-row.done .mini-pair,
  .need-row.done .mini {
    display: none;
  }
  .need-row.done .done-tag {
    display: inline-block;
    white-space: nowrap;
  }
  .need-empty {
    padding-top: 18px;
    color: var(--muted);
    font-size: 13px;
  }
  .need.all .need-empty {
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .need-row {
      flex-wrap: wrap;
    }
    .need-row.done .done-tag {
      white-space: normal;
    }
  }
</style>
