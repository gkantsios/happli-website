---
// Needs you list (illustration): an open gap and a waitlist match.
// interactive: real buttons and the data-* hooks for the walkthrough's script.
// Otherwise the buttons are drawn as plain labels (feature cards, /features).
interface Props {
  interactive?: boolean;
}
const { interactive = false } = Astro.props;
const Btn = interactive ? 'button' : 'span';
---

<div class:list={['need', { static: !interactive }]} data-need={interactive ? '' : undefined}>
  <div class="need-row">
    <div>
      <b>Open gap · Thu 1:15 – 2:15</b>
      <span>Dana has an hour free.</span>
    </div>
    <Btn type={interactive ? 'button' : undefined} class="mini" data-act={interactive ? 'gap' : undefined}>Draft an offer</Btn>
    <em class="done-tag">Offer drafted</em>
  </div>
  <div class="need-row">
    <div>
      <b>Waitlist match · Rapid tan</b>
      <span>Bea T. asked for Saturday morning · 10:00 is open.</span>
    </div>
    <div class="mini-pair">
      <Btn type={interactive ? 'button' : undefined} class="mini" data-act={interactive ? 'wl-book' : undefined}>Book</Btn>
      <Btn type={interactive ? 'button' : undefined} class="mini" data-act={interactive ? 'wl-dismiss' : undefined}>Dismiss</Btn>
    </div>
    <em class="done-tag" data-wl-tag={interactive ? '' : undefined}>Booked</em>
  </div>
  <p class="need-empty">Nothing else needs you. Enjoy your coffee.</p>
</div>

<style>
  .mini {
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .need:not(.static) .mini:hover {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }
  .static .mini {
    cursor: default;
  }
  .done-tag {
    display: none;
    font-style: normal;
    font-size: 12px;
    font-weight: 600;
    color: var(--sage-ink);
    background: var(--sage);
    padding: 5px 10px;
    border-radius: var(--radius-pill);
  }
  .need-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .need-row > div {
    flex: 1;
    min-width: 0;
  }
  .need-row b {
    display: block;
    font-weight: 600;
  }
  /* the row's description (not the button labels, which are spans when not interactive) */
  .need-row > div:first-child span {
    display: block;
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }
  .need-row > .mini-pair {
    flex: none;
    display: flex;
    gap: 6px;
  }
  .need-row.done .mini-pair,
  .need-row.done .mini {
    display: none;
  }
  .need-row.done .done-tag {
    display: inline-block;
    white-space: nowrap;
  }
  .need-empty {
    padding-top: 18px;
    color: var(--muted);
    font-size: 13px;
  }
  .need.all .need-empty {
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .need-row {
      flex-wrap: wrap;
    }
    .need-row.done .done-tag {
      white-space: normal;
    }
  }
</style>
