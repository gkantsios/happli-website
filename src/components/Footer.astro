---
import Logo from './Logo.astro';
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer-in">
      <div class="brand">
        <a href="/" aria-label="Happli home" class="brand-logo"><Logo height={24} /></a>
        <p>{site.tagline}</p>
      </div>
      <nav aria-labelledby="footer-product">
        <h2 id="footer-product">Product</h2>
        <ul>{site.footer.product.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="footer-company">
        <h2 id="footer-company">Company</h2>
        <ul>
          <li><a href={site.cta.href}>{site.cta.label}</a></li>
          <li><a href={site.signInUrl}>Sign in</a></li>
          <li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="footer-legal">
        <h2 id="footer-legal">Legal</h2>
        <ul>{site.footer.legal.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="legal">
      <p>© {year} Happli</p>
      <p>Made for spray tan studios and beauty pros.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-section);
    border-top: 1px solid var(--line);
    padding-block: 64px 40px;
    font-size: 14px;
  }
  .footer-in {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .brand-logo {
    display: inline-block;
    border-radius: 4px;
  }
  .brand p {
    margin-top: 16px;
    color: var(--muted);
    max-width: 22em;
    line-height: 1.55;
  }
  h2 {
    margin: 0 0 14px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  ul a {
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  ul a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  @media (max-width: 860px) {
    .footer-in {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
