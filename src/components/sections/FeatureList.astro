---
// A features-page section: heading on the left, a checklist of features on the right.
import Icon from '../Icon.astro';

export type FeatureItem = { title?: string; body: string; soon?: boolean };

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  items: FeatureItem[];
  soon?: boolean;
}
const { id, eyebrow, title, intro, items, soon = false } = Astro.props;
---

<section class="flist" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap flist-in">
    <div class="head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={`${id}-title`}>
        {title}
        {soon && <span class="badge">Coming soon</span>}
      </h2>
      {intro && <p class="intro">{intro}</p>}
      <slot name="note" />
    </div>
    <ul class="checks">
      {
        items.map((item) => (
          <li>
            <Icon name="check" size={16} strokeWidth={2} />
            <span>
              {item.title && <b>{item.title}</b>} {item.body}
              {item.soon && <span class="badge">Coming soon</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .flist {
    padding-block: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--line);
  }
  .flist:first-of-type {
    border-top: 0;
  }
  .flist-in {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 64px;
    align-items: start;
  }
  h2 {
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin-top: 12px;
  }
  h2 .badge {
    margin-left: 8px;
    font-family: var(--sans);
    letter-spacing: 0.06em;
  }
  .intro {
    margin-top: 14px;
    color: var(--muted);
    font-size: 15px;
    max-width: 26em;
  }
  .checks li > span .badge {
    margin-left: 6px;
  }
  @media (max-width: 860px) {
    .flist-in {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
