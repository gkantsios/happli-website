    color: var(--paper);
    display: grid;
    place-items: center;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* ---------- header band ---------- */
  .od-band {
    flex: none;
    height: 64px;
    background: rgba(247, 228, 218, 0.55);
    border-bottom: 1px solid rgba(43, 27, 26, 0.09);
