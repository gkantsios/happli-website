    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: var(--paper);
    overflow: hidden;
  }
  :focus-visible {
    outline: 2px solid var(--guava);
    outline-offset: 2px;
  }
  button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    text-align: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }
  p {
    margin: 0;
  }

  /* ---------- top nav ---------- */
  .od-nav {
    flex: none;
    height: 58px;
    background: var(--espresso);
    padding: 0 28px;
    display: flex;
    align-items: center;
    gap: 34px;
    cursor: default;
  }
  .od-logo {
    display: block;
    height: 24px;
  }
  .od-logo :global(svg) {
    height: 24px;
    width: auto;
  }
  .od-links {
    display: flex;
    gap: 28px;
    align-items: baseline;
  }
  .od-links span {
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    color: rgba(252, 246, 241, 0.6);
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
  }
  .od-links span.on {
    font-weight: 700;
    color: #fcf6f1;
