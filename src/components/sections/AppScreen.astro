    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
    box-shadow: 0 8px 18px -8px rgba(249, 114, 124, 0.6);
  }

  /* ---------- body ---------- */
  .od-body {
    flex: 1;
    min-height: 0;
    display: flex;
  }
  .od-book {
    flex: 1;
    min-width: 0;
    padding: 20px 0 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .od-daterow {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: default;
  }
  .od-date {
    font-family: var(--serif);
    font-optical-sizing: auto;
