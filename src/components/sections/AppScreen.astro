    --terracotta: #a85d58;
    --maroon: #5e3a38;
    --espresso: #2b1b1a;
    --olive: #6b6a45;
    --taupe: #a8978a;
    --gold: #9b7a33;
    --success-ink: #5a7a5e;
    --success-fill: #e6ede4;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    font-family: var(--sans);
    color: var(--espresso);
    text-align: left;
  }
