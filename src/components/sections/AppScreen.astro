    color: var(--maroon);
  }
  .od-locs span.on {
    background: var(--guava);
    color: #fff;
    font-weight: 700;
  }
  .od-stats {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .od-stat {
    display: flex;
    flex-direction: column;
  }
  .od-eyebrow {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    line-height: 1;
  }
  .od-stat-v {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-size: 19px;
    font-weight: 500;
