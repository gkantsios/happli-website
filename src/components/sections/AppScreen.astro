    background: var(--espresso);
    color: var(--paper);
  }
  .od-pill {
    border: 1px solid rgba(43, 27, 26, 0.14);
    border-radius: 999px;
    background: var(--paper);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--maroon);
    padding: 6px 12px;
    line-height: 1.2;
  }
  .od-needs-pill {
    display: none;
    padding: 6px 10px;
  }

  /* week strip */
  .od-week {
    display: flex;
    gap: 4px;
    margin-top: -4px;
  }
  .od-day {
    min-width: 36px;
    padding: 5px 6px 6px;
    border-radius: 10px;
    color: var(--maroon);
    border: 1px solid transparent;
    text-align: center;
    position: relative;
    transition: background 180ms var(--ease), color 180ms var(--ease);
  }
  .od-day .wd {
    display: block;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .od-day .num {
    display: block;
    font-size: 13px;
    font-weight: 600;
  }
  .od-day:hover {
    background: var(--cream);
    color: var(--espresso);
  }
  .od-day.sel,
  .od-day.sel:hover {
    background: var(--espresso);
    color: var(--paper);
    border-color: var(--espresso);
  }
  .od-day.sel .wd {
    color: rgba(252, 246, 241, 0.7);
  }
  .od-day.today::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--guava);
  }

  /* calendar card */
  .od-cal {
    background: #fff;
    border: 1px solid rgba(43, 27, 26, 0.14);
    border-radius: 12px;
    overflow: hidden;
  }
  .od-grid {
    display: grid;
    grid-template-columns: 64px repeat(3, 1fr);
  }
  .od-grid[hidden] {
    display: none;
  }
  .od-corner,
  .od-staff {
    background: rgba(247, 228, 218, 0.72);
    border-bottom: 1px solid rgba(43, 27, 26, 0.14);
    padding: 10px 8px;
    min-height: 44px;
  }
  .od-staff {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--espresso);
    border-left: 1px solid rgba(43, 27, 26, 0.08);
  }
  .od-staff-av {
    width: 24px;
    height: 24px;
    border-radius: 50%;
