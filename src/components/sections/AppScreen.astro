---
// Interactive demo of the Happli owner app (calendar day view), shown on the zoom hero's monitor.
// Laid out at a 1280 x 784 app size and CSS-scaled to the monitor by HeroZoom.
//
// Everything is sample data. The demo only shows what the app does today: nothing sends and
// nothing books. Drafts wait for approval, and checkout ends on "Paid".
//
// HeroZoom decides when the screen is usable: it keeps the app `inert` until the zoom has landed,
// and dispatches `od:landed` (detail: true/false) on the [data-od] root when that changes.
// With reduced motion the screen is always usable.
import Icon from '../Icon.astro';
import logoRaw from '../../../public/logo-white.svg?raw';

// ---------- demo data (the one source of truth) ----------
type Appt = { kind: 'appt'; start: string; end: string; client: string; service: string; price: number; deposit?: number; since?: string; note?: string };
type Hold = { kind: 'hold'; start: string; end: string; reason: string };
type Gap = { kind: 'gap'; start: string; end: string };
type Off = { kind: 'off'; start: string; end: string };
type Block = Appt | Hold | Gap | Off;
type Staff = { id: string; name: string; initials: string; color: string; open: [string, string][]; blocks: Block[] };

const STUDIO = 'Golden Glow';
const AXIS_START = 9 * 60;
const AXIS_END = 15 * 60;
const NOW = '11:42';

const toMin = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
};
const clock = (min: number) => {
  const h = Math.floor(min / 60);
  const m = min % 60;
  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')}`;
};
const ampm = (min: number) => (Math.floor(min / 60) >= 12 ? 'pm' : 'am');
const fmt = (min: number) => `${clock(min)} ${ampm(min)}`;
const range = (a: number, b: number) => `${fmt(a)} – ${fmt(b)}`;
const spoken = (a: number, b: number) => (ampm(a) === ampm(b) ? `${clock(a)} to ${fmt(b)}` : `${fmt(a)} to ${fmt(b)}`);

const appt = (start: string, end: string, client: string, service: string, price: number, extra: Partial<Appt> = {}): Appt => ({ kind: 'appt', start, end, client, service, price, ...extra });
const hold = (start: string, end: string, reason: string): Hold => ({ kind: 'hold', start, end, reason });
const gap = (start: string, end: string): Gap => ({ kind: 'gap', start, end });
const off = (start: string, end: string): Off => ({ kind: 'off', start, end });

const DANA = { id: 'dana', name: 'Dana', initials: 'DA', color: '#a85d58' };
const JESS = { id: 'jess', name: 'Jess', initials: 'JE', color: '#f89e69' };
const MAYA = { id: 'maya', name: 'Maya', initials: 'MA', color: '#6b6a45' };

// Thursday, Aug 27 ("today"). Every open stretch is booked or blocked except Dana's one gap,
// because the app marks every free stretch between bookings as a gap.
const thursday: Staff[] = [
  {
    ...DANA,
    open: [['9:00', '15:00']],
    blocks: [
      appt('9:00', '9:30', 'Sofia L.', 'Custom spray tan', 55),
      appt('9:30', '10:15', 'Ava R.', 'Rapid tan', 45),
      appt('10:15', '11:00', 'Chloe P.', 'Custom spray tan + contour', 70),
      appt('11:00', '11:30', 'Ana O.', 'Custom spray tan', 55, { deposit: 15, since: '2025', note: 'Light-medium shade. Prefers the 8-hour rinse.' }),
      hold('11:30', '12:15', 'Lunch'),
      appt('12:15', '13:15', 'Lena M.', 'Custom spray tan + contour', 70),
      gap('13:15', '14:15'),
      hold('14:15', '14:30', 'Break'),
      appt('14:30', '15:00', 'Tess M.', 'Rapid tan', 45),
    ],
  },
  {
    ...JESS,
    open: [['9:00', '12:00']],
    blocks: [
      appt('9:00', '9:30', 'Priya S.', 'Custom spray tan', 55),
      appt('9:30', '10:15', 'Emma J.', 'Rapid tan', 45),
      hold('10:15', '12:00', 'Training'),
      off('12:00', '15:00'),
    ],
  },
  {
    ...MAYA,
    open: [['12:00', '15:00']],
    blocks: [
      off('9:00', '12:00'),
      appt('12:00', '13:00', 'Bridal party', 'Group spray tan', 60),
      appt('13:00', '13:30', 'Nina T.', 'Custom spray tan', 55),
      appt('13:30', '14:15', 'Grace H.', 'Rapid tan', 45),
      hold('14:15', '15:00', 'Clean-up'),
    ],
  },
];

// Lighter prebuilt days for the week strip (no gaps). Mon and Tue reuse Wednesday.
const wednesday: Staff[] = [
  { ...DANA, open: [], blocks: [appt('10:00', '10:30', 'Olivia B.', 'Custom spray tan', 55), appt('13:00', '13:45', 'Mia C.', 'Rapid tan', 45)] },
  { ...JESS, open: [], blocks: [appt('9:30', '10:00', 'Harper G.', 'Custom spray tan', 55), off('12:00', '15:00')] },
  { ...MAYA, open: [], blocks: [off('9:00', '12:00')] },
];
const friday: Staff[] = [
  { ...DANA, open: [], blocks: [appt('9:30', '10:15', 'Zoe K.', 'Rapid tan', 45)] },
  { ...JESS, open: [], blocks: [appt('10:00', '10:30', 'Ruby S.', 'Custom spray tan', 55), off('12:00', '15:00')] },
  { ...MAYA, open: [], blocks: [off('9:00', '12:00'), appt('12:30', '13:30', 'Lily P.', 'Custom spray tan + contour', 70)] },
];
const weekend: Staff[] = [DANA, JESS, MAYA].map((s) => ({ ...s, open: [], blocks: [off('9:00', '15:00')] }));

const sets = [
  { key: 'thu', title: 'Thu, Aug 27', staff: thursday, today: true },
  { key: 'wed', title: 'Wed, Aug 26', staff: wednesday, today: false },
  { key: 'fri', title: 'Fri, Aug 28', staff: friday, today: false },
  { key: 'off', title: 'Sat, Aug 29', staff: weekend, today: false },
];
const week = [
  { wd: 'S', num: 23, set: 'off', title: 'Sun, Aug 23' },
  { wd: 'M', num: 24, set: 'wed', title: 'Mon, Aug 24' },
  { wd: 'T', num: 25, set: 'wed', title: 'Tue, Aug 25' },
  { wd: 'W', num: 26, set: 'wed', title: 'Wed, Aug 26' },
  { wd: 'T', num: 27, set: 'thu', title: 'Thu, Aug 27', today: true },
  { wd: 'F', num: 28, set: 'fri', title: 'Fri, Aug 28' },
  { wd: 'S', num: 29, set: 'off', title: 'Sat, Aug 29' },
];

// ---------- stats, computed like the app ----------
const dur = (b: { start: string; end: string }) => toMin(b.end) - toMin(b.start);
const appts = (s: Staff) => s.blocks.filter((b): b is Appt => b.kind === 'appt');
const bookedMin = (s: Staff) => appts(s).reduce((n, b) => n + dur(b), 0);
const openMin = (s: Staff) => s.open.reduce((n, [a, b]) => n + toMin(b) - toMin(a), 0);
const totalBooked = thursday.reduce((n, s) => n + bookedMin(s), 0);
const totalOpen = thursday.reduce((n, s) => n + openMin(s), 0);
const bookedLabel = `${Math.round(totalBooked / 60)} / ${Math.round(totalOpen / 60)}`;
const projected = thursday.reduce((n, s) => n + appts(s).reduce((m, b) => m + b.price, 0), 0);
const utilization = thursday.map((s) => ({ ...s, pct: Math.round((bookedMin(s) / openMin(s)) * 100) }));
const busiest = [...utilization].sort((a, b) => b.pct - a.pct)[0];
const summaryValue = `${bookedLabel} booked`;
const summaryNote = `${busiest.name} is at ${busiest.pct}% — your busiest schedule today.`;
const utilizationHeading = 'Utilization';

// Build-time check: edits to the data can't silently drift from the agreed numbers.
const expected = {
  bookedLabel: '8 / 12',
  projected: 600,
  utilization: 'Dana 67, Jess 42, Maya 75',
  summaryValue: '8 / 12 booked',
  summaryNote: 'Maya is at 75% — your busiest schedule today.',
};
const actual = {
  bookedLabel,
  projected,
  utilization: utilization.map((u) => `${u.name} ${u.pct}`).join(', '),
  summaryValue,
  summaryNote,
};
for (const k of Object.keys(expected) as (keyof typeof expected)[]) {
  if (expected[k] !== actual[k]) {
    throw new Error(`AppScreen demo data drifted: ${k} is "${actual[k]}", expected "${expected[k]}"`);
  }
}
if (/chair/i.test(`${utilizationHeading} ${summaryNote}`)) throw new Error('AppScreen: no "chair" wording');

// ---------- rendering helpers ----------
const HOUR_PX = 60;
const top = (t: string) => ((toMin(t) - AXIS_START) / 60) * HOUR_PX;
const height = (b: Block) => (dur(b) / 60) * HOUR_PX;
const hours = Array.from({ length: (AXIS_END - AXIS_START) / 60 }, (_, i) => AXIS_START + i * 60);
const hourLabel = (min: number) => `${((Math.floor(min / 60) + 11) % 12) + 1}${Math.floor(min / 60) >= 12 ? 'p' : 'a'}`;
const tint = (service: string) => (/rapid tan/i.test(service) ? 'cut' : /spray tan/i.test(service) ? 'skin' : 'neutral');
const nowTop = top(NOW);

const apptData = (b: Appt, s: Staff, dayTitle: string) =>
  JSON.stringify({
    client: b.client,
    service: b.service,
    price: b.price,
    deposit: b.deposit ?? 0,
    since: b.since ?? '',
    note: b.note ?? '',
    staff: s.name,
    minutes: dur(b),
    time: range(toMin(b.start), toMin(b.end)),
    day: dayTitle,
  });

// The logo for dark surfaces: the brand mark in guava, the word in cream (its "H" sits outside the groups).
const logoSvg = logoRaw
  .replace(/<\?xml[^>]*>\s*/, '')
  .replace(/<defs>[\s\S]*?<\/defs>\s*/, '')
  .replace(/ class="cls-1"/g, '')
  .replace('<g>', '<g fill="#f9727c">')
  .replace('<g>', '<g fill="#fcf6f1">')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" fill="#fcf6f1" ')
  .replace(/ id="logos"/, '');

const needsCount = 3;
---

<div class="od" data-od>
  <!-- top nav -->
  <div class="od-nav">
    <span class="od-logo" set:html={logoSvg} />
    <span class="od-links">
      <span class="on">Calendar</span><span>Clients</span><span>Messages</span><span>Reports</span>
    </span>
    <span class="od-tools">
      <span class="od-settings"><Icon name="settings" size={17} />Settings</span>
      <Icon name="search" size={17} />
      <Icon name="bell" size={17} />
      <span class="od-avatar">DK</span>
    </span>
  </div>

  <!-- header band -->
  <div class="od-band">
    <span class="od-locs"><span class="on">{STUDIO}</span><span>Mobile</span></span>
    <span class="od-stats">
      <span class="od-stat"><span class="od-eyebrow">Booked today</span><span class="od-stat-v">{bookedLabel}</span></span>
      <span class="od-stat"><span class="od-eyebrow">Projected</span><span class="od-stat-v">${projected}</span></span>
      <span class="od-new"><Icon name="plus" size={14} strokeWidth={2.2} />New booking</span>
    </span>
  </div>

  <div class="od-body">
    <!-- book -->
    <div class="od-book">
      <div class="od-daterow">
        <span class="od-date" data-od-title>Thu, Aug 27</span>
        <span class="od-circle"><Icon name="chevronLeft" size={16} /></span>
        <span class="od-circle"><Icon name="chevronRight" size={16} /></span>
        <span class="od-seg"><span class="on">Day</span><span>Week</span></span>
        <span class="od-pill">Waitlist</span>
        <button type="button" class="od-pill od-needs-pill" data-od-open="needs">
          Needs you <span data-od-needs-count>{needsCount}</span>
        </button>
      </div>

      <div class="od-week" role="group" aria-label="Days this week">
        {
          week.map((d) => (
            <button
              type="button"
              class:list={['od-day', { sel: d.today, today: d.today }]}
              data-od-day={d.set}
              data-od-title={d.title}
              aria-pressed={d.today ? 'true' : 'false'}
              aria-label={d.title}
            >
              <span class="wd">{d.wd}</span>
              <span class="num">{d.num}</span>
            </button>
          ))
        }
      </div>

      <div class="od-cal" data-od-cal>
        <div class="od-grid od-head">
          <div class="od-corner" />
          {
            thursday.map((s) => (
              <div class="od-staff">
                <span class="od-staff-av" style={`background:${s.color}`}>{s.initials}</span>
                {s.name}
              </div>
            ))
          }
        </div>
        {
          sets.map((set) => (
            <div class="od-grid od-grid-body" data-od-set={set.key} hidden={set.key !== 'thu'}>
              <div class="od-gutter">
                {hours.map((h) => (
                  <span class="od-hour" style={`top:${((h - AXIS_START) / 60) * HOUR_PX}px`}>
                    {hourLabel(h)}
                  </span>
                ))}
                {set.today && (
                  <span class="od-now-pill" style={`top:${nowTop}px`}>
                    {fmt(toMin(NOW))}
                  </span>
                )}
              </div>
              {set.staff.map((s) => (
                <div class="od-col" data-od-col={s.id}>
                  {s.blocks.map((b) => {
                    const style = `top:${top(b.start) + 1}px;height:${height(b) - 2}px`;
                    const size = dur(b) <= 15 ? 'tiny' : dur(b) <= 30 ? 'short' : '';
                    if (b.kind === 'appt')
                      return (
                        <button
                          type="button"
                          class:list={['od-bar', `t-${tint(b.service)}`, size]}
                          style={style}
                          data-od-appt={apptData(b, s, set.title)}
                          aria-label={`${b.client}, ${b.service}, ${spoken(toMin(b.start), toMin(b.end))}, with ${s.name}`}
                        >
                          <span class="od-bar-name">{b.client}</span>
                          <span class="od-bar-svc">{b.service}</span>
                        </button>
                      );
                    if (b.kind === 'gap')
                      return (
                        <button
                          type="button"
                          class="od-gap"
                          style={style}
                          data-od-gap={JSON.stringify({ staff: s.name, start: fmt(toMin(b.start)), day: set.title })}
                          aria-label={`Open gap with ${s.name}, ${spoken(toMin(b.start), toMin(b.end))}. Start a new booking`}
                        >
                          <span class="od-gap-label">Gap · {dur(b) / 60}h</span>
                          <span class="od-gap-cue">+ Book</span>
                        </button>
                      );
                    if (b.kind === 'hold')
                      return (
                        <div class:list={['od-hold', size]} style={style}>
                          <span>{b.reason}</span>
                        </div>
                      );
                    return (
                      <div class="od-off" style={style}>
                        <span>Off</span>
                      </div>
                    );
                  })}
                </div>
              ))}
              {set.today && <div class="od-now" style={`top:${nowTop}px`} />}
            </div>
          ))
        }
      </div>
    </div>

    <!-- right rail -->
    <aside class="od-rail" data-od-rail aria-label="Needs you and utilization">
      <div class="od-rail-idle" data-od-idle>
        <p class="od-rail-h">Needs you</p>
        <div class="od-needs" data-od-needs>
          <button type="button" class="od-need link" data-od-open="draft" data-od-need="draft">
            <span class="od-need-t">Gap offer · waiting for your approval</span>
            <span class="od-need-b">Maria K. for Dana's 1:15 pm opening on Thursday.</span>
            <span class="od-need-cta">Review draft →</span>
          </button>
          <div class="od-need">
            <span class="od-need-t">Dana · 1h gap</span>
            <span class="od-need-b">1:15 pm – 2:15 pm is open.</span>
          </div>
          <div class="od-need link hover-only">
            <span class="od-need-t">Waitlist · Emma J. joined online</span>
            <span class="od-need-b">Rapid tan on Sat, Aug 29, from the booking page. Book them when a time opens, or cancel the entry.</span>
            <span class="od-need-cta">Open in Waitlist →</span>
          </div>
        </div>
        <p class="od-rail-h od-rail-h2">{utilizationHeading}</p>
        <div class="od-util">
          {
            utilization.map((u) => (
              <div class="od-util-row">
                <span class="od-util-top">
                  <span class="nm">{u.name}</span>
                  <span class="pct">{u.pct}%</span>
                </span>
                <span class="od-track">
                  <span style={`width:${u.pct}%;background:${u.color}`} />
                </span>
              </div>
            ))
          }
        </div>
        <div class="od-summary">
          <p class="od-summary-e">{STUDIO}</p>
          <p class="od-summary-v">{summaryValue}</p>
          <p class="od-summary-n">{summaryNote}</p>
        </div>
      </div>
      <div class="od-rail-panel" data-od-rail-panel hidden></div>
    </aside>
  </div>

  <!-- panel templates (cloned into the rail, or the phone sheet) -->
  <template data-od-tpl="appt">
    <section class="pnl" aria-label="Appointment">
      <div class="pnl-head">
        <button type="button" class="pnl-x" data-od-act="close" aria-label="Close panel"><Icon name="close" size={16} strokeWidth={2} /></button>
        <p class="pnl-eyebrow">Appointment</p>
        <p class="pnl-name" data-slot="name"></p>
        <p class="pnl-meta" data-slot="meta"></p>
        <div class="pnl-chips" data-slot="chips"></div>
      </div>
      <div class="pnl-body">
        <div class="pnl-sec">
          <p class="pnl-label">Services</p>
          <div class="pnl-svc">
            <div>
              <p class="pnl-svc-name" data-slot="service"></p>
              <p class="pnl-svc-meta" data-slot="svcmeta"></p>
            </div>
            <p class="pnl-svc-price" data-slot="price"></p>
          </div>
        </div>
        <div class="pnl-sec" data-slot="notes" hidden>
          <p class="pnl-label">Notes</p>
          <p class="pnl-note" data-slot="note"></p>
        </div>
      </div>
      <div class="pnl-foot">
        <div data-view="default">
          <div class="pnl-total"><span>Booked service total</span><span data-slot="total"></span></div>
          <p class="pnl-dep" data-slot="deposit" hidden></p>
          <div class="pnl-actions">
            <button type="button" class="pnl-btn primary wide" data-od-act="checkout">Check out</button>
            <button type="button" class="pnl-btn ghost" aria-disabled="true">Reschedule</button>
            <button type="button" class="pnl-btn ghost" aria-disabled="true">More</button>
            <button type="button" class="pnl-msg" aria-disabled="true" aria-label="Message client"><Icon name="message" size={18} /></button>
          </div>
        </div>
        <div data-view="checkout" hidden>
          <div class="pnl-total"><span data-slot="balance"></span><span>balance due</span></div>
          <div class="pnl-tip">
            <span class="pnl-label">Tip</span>
            <span class="pnl-tips">
              <button type="button" class="pnl-tipbtn" data-od-act="tip" data-tip="5" aria-pressed="false">$5</button>
              <button type="button" class="pnl-tipbtn" data-od-act="tip" data-tip="10" aria-pressed="false">$10</button>
              <button type="button" class="pnl-tipbtn" data-od-act="tip" data-tip="15" aria-pressed="false">$15</button>
            </span>
          </div>
          <div class="pnl-actions">
            <button type="button" class="pnl-btn primary" data-od-act="pay">Card</button>
            <button type="button" class="pnl-btn ghost" data-od-act="pay">Mark paid (cash/other)</button>
            <button type="button" class="pnl-btn ghost" data-od-act="cancel-checkout">Cancel</button>
          </div>
          <p class="pnl-small">Demo only. In Happli, Card opens Stripe checkout.</p>
        </div>
        <div data-view="paid" hidden>
          <div class="pnl-total"><span data-slot="paid">Paid</span></div>
        </div>
      </div>
    </section>
  </template>

  <template data-od-tpl="new">
    <section class="pnl" aria-label="New booking">
      <div class="pnl-head">
        <button type="button" class="pnl-x" data-od-act="close" aria-label="Close panel"><Icon name="close" size={16} strokeWidth={2} /></button>
        <p class="pnl-eyebrow" data-slot="eyebrow"></p>
        <p class="pnl-name">New booking</p>
        <p class="pnl-meta" data-slot="meta"></p>
      </div>
      <div class="pnl-body">
        <div class="pnl-sec">
          <p class="pnl-label">Client</p>
          <div class="pnl-search"><Icon name="search" size={15} /><span>Search by name or phone</span></div>
          <span class="pnl-dashed">+ Add a walk-in</span>
        </div>
        <div class="pnl-sec">
          <p class="pnl-label">Service</p>
          <span class="pnl-dashed">+ Choose from your menu</span>
        </div>
      </div>
      <div class="pnl-foot">
        <div class="pnl-actions">
          <button type="button" class="pnl-btn primary is-disabled" aria-disabled="true">Book</button>
          <button type="button" class="pnl-btn ghost" data-od-act="close">Cancel</button>
        </div>
        <p class="pnl-small">Add a client and a service to book.</p>
      </div>
    </section>
  </template>

  <template data-od-tpl="draft">
    <section class="pnl" aria-label="Gap offer draft">
      <div class="pnl-head">
        <button type="button" class="pnl-x" data-od-act="close" aria-label="Close panel"><Icon name="close" size={16} strokeWidth={2} /></button>
        <p class="pnl-eyebrow">Gap offer</p>
        <p class="pnl-name">Maria K.</p>
        <p class="pnl-meta">Dana · Thu, Aug 27 · 1:15 pm</p>
      </div>
      <div class="pnl-body">
        <div class="pnl-sec">
          <p class="pnl-label">Draft</p>
          <p class="pnl-bubble">Hi Maria! A 1:15 spot just opened Thursday with Dana. Book it here: goldenglow.gohappli.com</p>
          <p class="pnl-small">In Happli, drafts are approved in Messages.</p>
        </div>
      </div>
      <div class="pnl-foot">
        <div class="pnl-actions" data-view="default">
          <button type="button" class="pnl-btn primary" data-od-act="approve">Approve</button>
          <button type="button" class="pnl-btn ghost" data-od-act="reject">Reject</button>
        </div>
        <p class="pnl-status" data-view="done" hidden><i></i><span data-slot="status"></span></p>
      </div>
    </section>
  </template>

  <template data-od-tpl="needs">
    <section class="pnl" aria-label="Needs you">
      <div class="pnl-head">
        <button type="button" class="pnl-x" data-od-act="close" aria-label="Close panel"><Icon name="close" size={16} strokeWidth={2} /></button>
        <p class="pnl-eyebrow">{STUDIO}</p>
        <p class="pnl-name">Needs you</p>
      </div>
      <div class="pnl-body">
        <div class="od-needs" data-slot="needs"></div>
      </div>
    </section>
  </template>
</div>

<!-- phone bottom sheet: page-scale, moved into the hero stage by the script below -->
<div class="od od-sheet" data-od-sheet role="region" aria-label="Demo panel" hidden>
  <div class="od-sheet-body" data-od-sheet-body></div>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-od]');
    var sheet = document.querySelector('[data-od-sheet]');
    if (!root || !sheet) return;
    var zoom = root.closest('[data-zoom]');
    var stage = zoom ? zoom.querySelector('.stage') : null;
    if (stage) stage.appendChild(sheet); // out of the scaled monitor, into the hero stage
    var sheetBody = sheet.querySelector('[data-od-sheet-body]');
    var rail = root.querySelector('[data-od-rail]');
    var railIdle = root.querySelector('[data-od-idle]');
    var railPanel = root.querySelector('[data-od-rail-panel]');
    var cal = root.querySelector('[data-od-cal]');
    var phone = window.matchMedia('(max-width: 699.98px)');
    var current = null; // { node, kind, opener, ghost, where }
    var needsLeft = 3;

    function fill(node, slot, text) {
      var el = node.querySelector('[data-slot="' + slot + '"]');
      if (el) el.textContent = text;
      return el;
    }
    function view(node, name) {
      node.setAttribute('data-state', name);
      node.querySelectorAll('[data-view]').forEach(function (v) {
        v.hidden = v.getAttribute('data-view') !== name;
      });
    }
    function chip(text, ok) {
      var c = document.createElement('span');
      c.className = 'pnl-chip' + (ok ? ' ok' : '');
      c.textContent = text;
      return c;
    }

    function open(kind, data, opener) {
      close(true);
      var tpl = root.querySelector('template[data-od-tpl="' + kind + '"]');
      // template content carries the component's scoped-style attributes, so clones are styled
      var node = tpl.content.firstElementChild.cloneNode(true);
      var ghost = null;

      if (kind === 'appt') {
        fill(node, 'name', data.client);
        fill(node, 'meta', data.time + ' · with ' + data.staff);
        var chips = node.querySelector('[data-slot="chips"]');
        chips.appendChild(chip('Confirmed', true));
        if (data.deposit) chips.appendChild(chip('Deposit paid'));
        if (data.since) chips.appendChild(chip('Client since ' + data.since));
        fill(node, 'service', data.service);
        fill(node, 'svcmeta', data.minutes + ' min · with ' + data.staff);
        fill(node, 'price', '$' + data.price);
        fill(node, 'total', '$' + data.price);
        if (data.deposit) fill(node, 'deposit', 'Deposit · Paid $' + data.deposit).hidden = false;
        if (data.note) {
          fill(node, 'note', data.note);
          node.querySelector('[data-slot="notes"]').hidden = false;
        }
        fill(node, 'balance', '$' + (data.price - data.deposit));
        node._appt = data;
        node._tip = 0;
      }
      if (kind === 'new') {
        fill(node, 'eyebrow', 'Golden Glow · ' + data.day);
        fill(node, 'meta', data.staff + ' at ' + data.start);
        if (opener && opener.classList.contains('od-gap')) {
          ghost = document.createElement('div');
          ghost.className = 'od-ghost';
          ghost.textContent = 'New · ' + data.start;
          ghost.setAttribute('style', opener.getAttribute('style'));
          // carry the component's scope attribute so the ghost is styled
          for (var i = 0; i < opener.attributes.length; i++) {
            var a = opener.attributes[i].name;
            if (a.indexOf('data-astro-cid') === 0) ghost.setAttribute(a, '');
          }
          opener.parentNode.appendChild(ghost);
          opener.classList.add('is-drafting');
        }
      }
      if (kind === 'needs') {
        var list = node.querySelector('[data-slot="needs"]');
        root.querySelectorAll('[data-od-needs] > *').forEach(function (card) {
          list.appendChild(card.cloneNode(true));
        });
      }

      var where = phone.matches ? 'sheet' : 'rail';
      if (where === 'sheet') {
        sheetBody.appendChild(node);
        sheet.hidden = false;
      } else {
        railPanel.appendChild(node);
        railPanel.hidden = false;
        railIdle.hidden = true;
        rail.classList.add('has-panel');
      }
      current = { node: node, kind: kind, opener: opener, ghost: ghost, where: where };
      var x = node.querySelector('.pnl-x');
      if (x) x.focus({ preventScroll: true });
    }

    function close(silent) {
      if (!current) return;
      var c = current;
      current = null;
      c.node.remove();
      if (c.ghost) {
        c.ghost.remove();
        c.opener.classList.remove('is-drafting');
      }
      sheet.hidden = true;
      railPanel.hidden = true;
      railIdle.hidden = false;
      rail.classList.remove('has-panel');
      if (!silent) {
        var back = c.opener && document.contains(c.opener) && !c.opener.closest('[inert]') ? c.opener : null;
        if (!back) back = root.querySelector('[data-od-needs] > button') || root.querySelector('.od-bar');
        if (back) back.focus({ preventScroll: true });
      }
    }

    function removeDraftCard() {
      var card = root.querySelector('[data-od-need="draft"]');
      if (card) card.remove();
      needsLeft = Math.max(0, needsLeft - 1);
      root.querySelectorAll('[data-od-needs-count]').forEach(function (n) {
        n.textContent = needsLeft;
      });
    }

    function onClick(e) {
      var t = e.target;
      var bar = t.closest('[data-od-appt]');
      if (bar && root.contains(bar)) return open('appt', JSON.parse(bar.getAttribute('data-od-appt')), bar);
      var gapBtn = t.closest('[data-od-gap]');
      if (gapBtn && root.contains(gapBtn)) return open('new', JSON.parse(gapBtn.getAttribute('data-od-gap')), gapBtn);
      var opener = t.closest('[data-od-open]');
      if (opener) {
        var what = opener.getAttribute('data-od-open');
        if (what === 'draft') return open('draft', {}, opener);
        if (what === 'needs') return open('needs', {}, opener);
        if (what === 'ana') {
          var ana = root.querySelector('[data-od-set="thu"] .od-bar[aria-label^="Ana O."]');
          return open('appt', JSON.parse(ana.getAttribute('data-od-appt')), opener);
        }
      }
      var day = t.closest('[data-od-day]');
      if (day && root.contains(day)) {
        close(true);
        root.querySelectorAll('[data-od-day]').forEach(function (d) {
          var on = d === day;
          d.classList.toggle('sel', on);
          d.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        var key = day.getAttribute('data-od-day');
        root.querySelectorAll('[data-od-set]').forEach(function (s) {
          s.hidden = s.getAttribute('data-od-set') !== key;
        });
        root.querySelector('[data-od-title]').textContent = day.getAttribute('data-od-title');
        return;
      }

      var act = t.closest('[data-od-act]');
      if (act && current && current.node.contains(act)) {
        var a = act.getAttribute('data-od-act');
        var node = current.node;
        if (act.getAttribute('aria-disabled') === 'true') return;
        if (a === 'close') return close(false);
        if (a === 'checkout') return view(node, 'checkout');
        if (a === 'cancel-checkout') return view(node, 'default');
        if (a === 'tip') {
          var v = +act.getAttribute('data-tip');
          node._tip = node._tip === v ? 0 : v;
          node.querySelectorAll('[data-od-act="tip"]').forEach(function (b) {
            b.setAttribute('aria-pressed', +b.getAttribute('data-tip') === node._tip ? 'true' : 'false');
          });
          return;
        }
        if (a === 'pay') {
          var status = node.querySelector('.pnl-chip.ok');
          if (status) status.textContent = 'Completed';
          fill(node, 'paid', node._tip ? 'Paid · tip $' + node._tip : 'Paid');
          view(node, 'paid');
          node.querySelector('.pnl-x').focus({ preventScroll: true });
          return;
        }
        if (a === 'approve' || a === 'reject') {
          fill(node, 'status', a === 'approve' ? 'Approved · sent to Maria' : 'Rejected · nothing was sent');
          view(node, 'done');
          node.querySelector('.pnl-status').classList.toggle('rejected', a === 'reject');
          removeDraftCard();
          node.querySelector('.pnl-x').focus({ preventScroll: true });
          return;
        }
        return;
      }

      // Clicking empty calendar area closes the panel; clicks inside the panel never do.
      if (current && cal.contains(t) && !t.closest('button')) close(false);
    }

    root.addEventListener('click', onClick);
    sheet.addEventListener('click', onClick);
    if (zoom) {
      // page-scale chips (phones) live in the hero stage, outside this component
      zoom.addEventListener('click', function (e) {
        var chipBtn = e.target.closest('[data-od-open]');
        if (chipBtn && !root.contains(chipBtn) && !sheet.contains(chipBtn)) onClick(e);
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && current) close(false);
    });
    phone.addEventListener('change', function () {
      close(true);
    });

    // HeroZoom tells us when the screen is (not) usable.
    root.addEventListener('od:landed', function (e) {
      if (e.detail) return;
      var active = document.activeElement;
      var hadFocus = active && (root.contains(active) || sheet.contains(active) || (zoom && zoom.querySelector('[data-od-chips]') && zoom.querySelector('[data-od-chips]').contains(active)));
      close(true);
      if (hadFocus && zoom) {
        // move focus to the first focusable element after the hero
        var all = document.querySelectorAll('a[href], button:not([disabled]), [tabindex="0"]');
        for (var i = 0; i < all.length; i++) {
          if (zoom.compareDocumentPosition(all[i]) & Node.DOCUMENT_POSITION_FOLLOWING && !zoom.contains(all[i])) {
            all[i].focus({ preventScroll: true });
            break;
          }
        }
      }
    });
  })();
</script>

<style>
  /* ---------- the app's design tokens (owner-desktop.css), scoped to the demo ---------- */
