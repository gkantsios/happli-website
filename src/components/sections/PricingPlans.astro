---
// Founding member plans (prices and Stripe links live in src/config/pricing.ts).
import Icon from '../Icon.astro';
import { plans, foundingPerks, pricingFootnote } from '../../config/pricing';

interface Props {
  /** Show the "everything in every plan" list below the cards. */
  included?: boolean;
}
const { included = true } = Astro.props;

const every = [
  'Online booking page for each location',
  'Deposits, card checkout, tips and sales tax',
  'Packages',
  'Reminders and custom messages by text and email',
  'Waitlist matches and gap offers',
];
// TODO confirm: whether the website chat assistant, reports and client import are included in all three plans
// (the old placeholder table left them open), then add them here.
---

<section class="plans-section" aria-labelledby="plans-title">
  <div class="wrap">
    <h2 id="plans-title" class="visually-hidden">Founding member plans</h2>
    <p class="founding"><span class="badge">Founding member pricing</span> Priced by number of locations. Billed monthly.</p>
    <div class="plans" data-reveal-stagger>
      {
        plans.map((plan) => (
          <article class:list={['plan', { featured: 'featured' in plan }]}>
            <h3>{plan.name}</h3>
            <p class="price">
              <span class="amount">${plan.price}</span>
              <span class="unit">/ month</span>
            </p>
            <p class="best">{plan.bestFor}</p>
            <a class:list={['btn', 'featured' in plan ? 'btn-coral' : 'btn-ghost']} href={plan.href} rel="noopener">
              Choose {plan.name}
            </a>
          </article>
        ))
      }
    </div>

    <div class="perks">
      <h3>Every founding member gets</h3>
      <ul class="checks">
        {foundingPerks.map((p) => <li><Icon name="check" size={16} strokeWidth={2} /><span>{p}</span></li>)}
      </ul>
    </div>

    {
      included && (
        <div class="perks">
          <h3>Every plan includes</h3>
          <ul class="checks">
            {every.map((p) => <li><Icon name="check" size={16} strokeWidth={2} /><span>{p}</span></li>)}
          </ul>
          <p class="more"><a href="/features/">See every feature</a></p>
        </div>
      )
    }

    <p class="footnote">{pricingFootnote}</p>
  </div>
</section>

<style>
  .plans-section {
    padding-top: var(--space-block);
  }
  .founding {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 15px;
    color: var(--ink-2);
  }
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 24px;
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px 28px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }
  .plan.featured {
    border-color: var(--coral);
    box-shadow: var(--shadow-card);
  }
  h3 {
    font-size: 24px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .amount {
    font-family: var(--serif);
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .unit {
    color: var(--muted);
    font-size: 15px;
  }
  .best {
    color: var(--ink-2);
    font-size: 15px;
    margin-bottom: 8px;
  }
  .plan .btn {
    margin-top: auto;
  }
  .perks {
    margin-top: 48px;
    max-width: 44em;
  }
  .perks h3 {
    font-family: var(--sans);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 18px;
  }
  .more {
    margin-top: 18px;
    font-size: 15px;
  }
  .more a {
    color: var(--coral-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footnote {
    margin-top: 40px;
    max-width: 52em;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
