---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  center?: boolean;
}
const { eyebrow, title, id, center = false } = Astro.props;
---

<div class:list={['section-head', { center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {Astro.slots.has('default') && <div class="lede"><slot /></div>}
</div>

<style>
  .center {
    margin-inline: auto;
    text-align: center;
  }
  .center .lede {
    margin-inline: auto;
  }
  .lede :global(p + p) {
    margin-top: 12px;
  }
</style>
