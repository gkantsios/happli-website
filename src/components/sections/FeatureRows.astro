---
// /features: four alternating text-and-mock rows above the full feature lists.
import NeedsList from '../mocks/NeedsList.astro';
import PhoneBooking from '../mocks/PhoneBooking.astro';
import CheckoutSheet from '../mocks/CheckoutSheet.astro';
import ReminderPreview from '../mocks/ReminderPreview.astro';

const rows = [
  {
    id: 'row-needs-you',
    eyebrow: 'Needs you and gap offers',
    title: 'Everything that needs you, in one list',
    body: 'Open gaps, waitlist matches and drafts waiting for approval collect in Needs you. For a gap, pick one client and Happli drafts the text. It sends only after you approve it.',
    mock: 'needs',
  },
  {
    id: 'row-booking-page',
    eyebrow: 'Your booking page',
    title: 'A booking page built for phones',
    body: 'Clients pick a service, choose a day on a calendar sized for small screens, and grab an open time. A time is held while they finish booking. Share the link or embed it on your site.',
    mock: 'phone',
  },
  {
    id: 'row-checkout',
    eyebrow: 'Deposits and checkout',
    title: 'Deposits and checkout on one sheet',
    // TODO confirm: live card payments need the Stripe go-live steps.
    body: 'Require a deposit before an online booking is confirmed. At checkout, collect the balance with a suggested tip and sales tax, or mark it paid for cash.',
    mock: 'checkout',
  },
  {
    id: 'row-reminders',
    eyebrow: 'Reminders and messages',
    title: 'Reminders in your own words',
    // TODO confirm: live texting to clients.
    body: 'Pick text, email or both for each message. Edit the wording with fill-in fields like first name, service and time, preview it, and send yourself a test.',
    mock: 'reminder',
  },
] as const;
---

<div class="rows">
  {
    rows.map((r) => (
      <section class="row" id={r.id} aria-labelledby={`${r.id}-title`}>
        <div class="wrap row-in">
          <div class="mock" aria-hidden="true">
            {r.mock === 'phone' ? (
              <PhoneBooking />
            ) : (
              <div class="win">
                {r.mock === 'needs' && <NeedsList />}
                {r.mock === 'checkout' && <CheckoutSheet />}
                {r.mock === 'reminder' && <ReminderPreview />}
              </div>
            )}
          </div>
          <div class="text">
            <p class="eyebrow">{r.eyebrow}</p>
            <h2 id={`${r.id}-title`}>{r.title}</h2>
            <p class="lede">{r.body}</p>
          </div>
        </div>
      </section>
    ))
  }
</div>

<style>
  .rows {
    margin-top: var(--space-block);
  }
  .row {
    padding-block: clamp(32px, 5vw, 56px);
  }
  .row-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .row-in {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 64px;
    }
    .row:nth-child(even) .mock {
      order: 2;
    }
  }
  .mock {
    display: flex;
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 20px;
    background:
      radial-gradient(70% 80% at 20% 0%, #f8dad6 0%, rgba(248, 218, 214, 0) 70%),
      linear-gradient(160deg, var(--blush-2), var(--blush));
  }
  .win {
    width: 100%;
    max-width: 460px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 6px 18px 18px;
    box-shadow: 0 20px 40px -28px rgba(27, 22, 20, 0.35);
  }
  h2 {
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin-top: 12px;
  }
  .lede {
    margin-top: 16px;
  }
</style>
