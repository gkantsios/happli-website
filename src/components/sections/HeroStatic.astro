---
import Icon from '../Icon.astro';
import ProductBook from './ProductBook.astro';
import { site } from '../../config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-copy">
    <p class="eyebrow">For spray tan studios and beauty pros</p>
    <h1 id="hero-title">Your front desk, <em>down to one short list.</em></h1>
    <p class="lede">
      Clients book, pay deposits and get reminders on their own. Anything that needs you (gaps, waitlist matches,
      texts to approve) lands in Needs you.
    </p>
    <div class="btn-row hero-actions">
      <a class="btn btn-coral" href={site.cta.href}>{site.cta.label}</a>
      <a class="btn btn-ghost" href="#walkthrough">See a day in Happli</a>
    </div>
    <p class="hero-note">
      <Icon name="check" size={13} strokeWidth={2.2} />
      Drafted texts wait for your approval.
    </p>
  </div>
  <div class="wrap">
    <ProductBook />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(56px, 8vw, 96px);
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(246, 233, 228, 0.95) 0%, rgba(246, 233, 228, 0) 70%),
      radial-gradient(40% 40% at 90% 30%, rgba(243, 231, 214, 0.7) 0%, rgba(243, 231, 214, 0) 70%),
      var(--bg);
  }
  .hero-copy {
    text-align: center;
  }
  h1 {
    font-size: var(--fs-h1);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 18px auto 0;
    max-width: 13em;
  }
  h1 em {
    display: block;
    font-style: italic;
    font-weight: 300;
  }
  .lede {
    margin: 24px auto 0;
    font-size: clamp(16px, 1.3vw, 18px);
    max-width: 60ch;
  }
  .hero-actions {
    justify-content: center;
    margin-top: 30px;
  }
  .hero-note {
    margin-top: 18px;
    font-size: 13px;
    color: var(--muted);
    text-wrap: balance;
  }
  .hero-note :global(svg) {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 6px;
  }
</style>
