---
// Phones only (below 700px): a bottom bar with the site's "Book a demo" button.
// It shows whenever none of the page's own "Book a demo" buttons is visible (the header's is
// hidden on phones), so exactly one is on screen at every scroll position, the footer included.
// Without JavaScript it never appears.
//
// A page button counts as visible only when it's below the sticky header's bottom edge (measured
// live) and, in the zoom hero, while its copy is at 40% opacity or more (the copy fades while its box
// stays put). The bar publishes its height as --cta-bar-h so the hero's phone sheet sits above it.
// (Comments live up here, not in the inline script, so they don't ship in every page.)
import { site } from '../config/site';
---

<div class="sticky-cta" data-sticky-cta aria-hidden="true" inert>
  <a class="btn btn-coral" href={site.cta.href}>{site.cta.label}</a>
</div>

<script is:inline>
  (function () {
    var bar = document.querySelector('[data-sticky-cta]');
    if (!bar) return;
    var phone = window.matchMedia('(max-width: 699.98px)');
    var href = bar.firstElementChild.getAttribute('href');
    var ctas = [].filter.call(document.querySelectorAll('main a.btn'), function (a) {
      return a.getAttribute('href') === href;
    });
    var header = document.querySelector('header.nav');
    function seen(el) {
      var r = el.getBoundingClientRect();
      var top = header ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
      if (r.width < 2 || r.bottom <= top || r.top >= window.innerHeight) return false;
      if (el.closest('[inert]')) return false;
      var o = 1;
      for (var n = el; n && n.nodeType === 1; n = n.parentElement) {
        var cs = getComputedStyle(n);
        if (cs.display === 'none' || cs.visibility === 'hidden') return false;
        o *= +cs.opacity;
      }
      return o >= 0.4;
    }
    var shown = null;
    var queued = false;
    function sync() {
      queued = false;
      var show = phone.matches && !ctas.some(seen);
      if (show === shown) return;
      shown = show;
      bar.classList.toggle('is-shown', show);
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
      bar.inert = !show;
      document.documentElement.style.setProperty('--cta-bar-h', show ? bar.offsetHeight + 'px' : '0px');
    }
    function queue() {
      if (!queued) {
        queued = true;
        requestAnimationFrame(sync);
      }
    }
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    phone.addEventListener('change', queue);
    window.addEventListener('load', queue);
    sync();
  })();
</script>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
    background: rgba(251, 250, 248, 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    visibility: hidden;
    transition: transform 0.25s ease, visibility 0.25s;
  }
  .sticky-cta.is-shown {
    transform: none;
    visibility: visible;
  }
  .sticky-cta .btn {
    width: 100%;
  }
  @media (min-width: 700px) {
    .sticky-cta {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
  }
</style>
