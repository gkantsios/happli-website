---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import PricingPlans from '../components/sections/PricingPlans.astro';
import SectionHead from '../components/sections/SectionHead.astro';
import { breadcrumbs } from '../lib/jsonld';
import { site } from '../config/site';
import { solo, founding, trialDays, usd } from '../config/pricing';

const title = 'Get Started | Join Happli as a Founding Studio';
const description = `Join Happli from ${usd(solo.monthly)} a month, with ${founding.discountPercent}% off for Founding Studios. Free until you go live. Booking software for spray tan and beauty studios, with AI built in.`;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbs([{ name: 'Home', href: '/' }, { name: 'Get started', href: '/signup/' }])]}
>
  <PageIntro
    eyebrow="Get started"
    title="Join as a Founding Studio."
    lede={`Pick Solo or Studio, then book a call and we'll set you up for free. Happli is free until your studio goes live, for up to ${trialDays} days.`}
    cta={false}
  >
    <div class="btn-row call">
      <a class="btn btn-coral" href={site.cta.href}>Book a call</a>
      {site.demo.enabled && <a class="btn btn-ghost" href={site.demo.href}>{site.demo.label}</a>}
    </div>
  </PageIntro>

  <PricingPlans included={false} cta="call" />

  <section class="section" aria-labelledby="next-title">
    <div class="wrap">
      <SectionHead eyebrow="What happens next" title="From your first call to your first booking." id="next-title" />
      {/* TODO confirm: the exact onboarding steps and timing. Online checkout comes back once the new Stripe Payment Links exist. */}
      <ol class="next">
        <li><b>Book a call.</b> Pick a time and tell us about your studio and team.</li>
        <li><b>Set up your studio, free.</b> Add services, team and hours, and we bring your clients over from CSV if you're switching. There's no setup fee.</li>
        <li><b>Go live.</b> Happli is free until your studio goes live, for up to {trialDays} days. Then you pay for Solo or Studio, monthly or yearly.</li>
      </ol>
      <p class="help">Questions first? <a href="/pricing/">See pricing details</a>, <a href="/help/">visit Help</a> or email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .call {
    margin-top: 28px;
  }
  .next {
    margin: 32px 0 0;
    padding-left: 22px;
    display: grid;
    gap: 14px;
    max-width: 44em;
    color: var(--ink-2);
  }
  .next b {
    color: var(--ink);
  }
  .help {
    margin-top: 32px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .help a {
    color: var(--coral-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
