---
// Hidden page for a Vimeo update video: not linked from the site, noindex, and left out of the sitemap
// (astro.config.mjs). The Vimeo player frame is allowed by frame-src in public/_headers.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Happli update | Happli" description="A short video update from Happli." noindex>
  <section class="thanks">
    <div class="wrap">
      <h1>Happli update</h1>
      <div class="video">
        <iframe
          src="https://player.vimeo.com/video/1247337676?autopause=0&player_id=0&app_id=58479"
          allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          title="Happli Update"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    padding: clamp(48px, 8vw, 96px) 0;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 52px);
    line-height: 1.1;
    text-align: center;
  }
  .video {
    position: relative;
    max-width: 880px;
    margin: 32px auto 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--ink);
  }
  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
