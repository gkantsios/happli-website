---
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPublished } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublished('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, posts } }));
}

const { entry, posts } = Astro.props;
const { Content, headings } = await render(entry);
---

<BlogPostLayout entry={entry} headings={headings} posts={posts}>
  <Content />
</BlogPostLayout>
