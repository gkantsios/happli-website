---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import PostList from '../../components/PostList.astro';
import { getPublished } from '../../lib/posts';
import { breadcrumbs } from '../../lib/jsonld';
import { site } from '../../config/site';

const posts = await getPublished('blog');
---

<BaseLayout
  title="Happli Blog | Tips for salon, spa and beauty studio owners"
  description="Practical tips for salon, spa and beauty studio owners on getting found, booking, deposits and reminders."
  jsonLd={[breadcrumbs([{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog/' }])]}
  noindex={!site.sections.blog}
>
  <PageIntro eyebrow="Blog" title="Notes for busy studio owners." cta={false} />
  <div class="wrap">
    <PostList entries={posts} base="/blog/" readingTime empty="The first posts are on their way. Check back soon." />
  </div>
</BaseLayout>
