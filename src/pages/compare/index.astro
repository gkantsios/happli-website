---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/sections/PageIntro.astro';
import PostList from '../../components/PostList.astro';
import { getPublished } from '../../lib/posts';
import { breadcrumbs } from '../../lib/jsonld';

const pages = await getPublished('compare');
---

<BaseLayout
  title="Compare Happli | Booking Software Alternatives for Spray Tan Studios"
  description="Honest comparisons between Happli and other booking systems for spray tan studios and beauty pros."
  jsonLd={[breadcrumbs([{ name: 'Home', href: '/' }, { name: 'Compare', href: '/compare/' }])]}
>
  <PageIntro eyebrow="Compare" title="How Happli compares." cta={false} />
  <div class="wrap">
    <PostList entries={pages} base="/compare/" empty="Comparison pages are on their way. Check back soon." />
  </div>
</BaseLayout>
