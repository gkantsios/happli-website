---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import { breadcrumbs } from '../lib/jsonld';
import { site } from '../config/site';

const title = 'Roadmap | What we are building next at Happli';
const description = "What's live in Happli, what's in progress and what's later. Suggest a feature anytime.";

// Each column is a list of groups. Live groups its cards under short headings; the other columns have one unheaded group.
type Group = { heading?: string; items: { title: string; body: string }[] };
// A column with `collapse` shows only its first group until the visitor opens the rest.
const columns: { id: string; label: string; collapse?: boolean; groups: Group[] }[] = [
  {
    id: 'live',
    label: 'Live',
    collapse: true,
    groups: [
      {
        heading: 'Booking',
        items: [
          { title: 'Online booking page', body: 'A public page for each location that you can share as a link or embed on your website.' },
          { title: 'Booking on your own website', body: 'Clients book in a window right on your site, without leaving it.' },
          { title: 'Phone-friendly calendar', body: 'Clients pick a day and an open time. A slot is held while they finish booking.' },
          { title: 'Booking rules', body: 'Set the minimum notice, how far ahead clients can book, and your cancellation window.' },
          { title: 'Hours and closures', body: "Set each team member's working hours and add closed days. Closed days disappear from the booking page." },
          { title: 'Add-ons at booking', body: 'Clients can add optional extras when they book.' },
          { title: 'Deposits at booking', body: 'Require a deposit, as a percentage of the service, for online bookings, bookings by your team, or both.' },
        ],
      },
      {
        heading: 'Calendar and front desk',
        items: [
          { title: 'Day and week views', body: 'See each team member in their own column, or everyone at once.' },
          { title: 'One appointment panel', body: 'Confirm, check out, reschedule, cancel, or mark a no-show, with notes.' },
          { title: 'Reschedule with confidence', body: 'Drag to a new time or pick a new slot, then confirm before anything moves.' },
          { title: 'Block time', body: 'Hold breaks, training, or personal time on the calendar.' },
          { title: 'New or existing clients', body: 'Search by name or phone, add a new client, or book a walk-in.' },
          { title: 'Needs you list', body: 'Open gaps, waitlist matches, and drafts waiting for your approval, in one spot.' },
          { title: 'Check your day from your phone', body: 'A phone-sized view of the calendar and Needs you.' },
        ],
      },
      {
        heading: 'Payments',
        items: [
          { title: 'Stripe Connect', body: 'Connect your own Stripe account from Settings. Charges go to your account, and Happli takes no fee.' },
          { title: 'Card checkout, cash, tips, and tax', body: 'Take a card, mark cash or other payments as paid, offer tip amounts you choose, and add sales tax at your rate.' },
          { title: 'Deposits with Apple Pay and Google Pay', body: 'Clients pay their deposit in a tap, right on the booking page.' },
          { title: 'No-show fees', body: 'Charge a percentage of the service through a secure payment link.' },
          { title: 'Refunds', body: 'Issue a refund from the appointment.' },
          { title: 'Gift cards', body: 'Sell gift cards online or at the desk, and redeem them at checkout.' },
          { title: 'Prepaid packages', body: 'Create packages of sessions, sell them, and see what each client has left.' },
          { title: 'Inventory and retail products', body: 'Keep track of the products you sell and how many you have in stock.' },
          { title: 'Professional supplies', body: 'Track the supplies each service uses. They come out of stock when the visit is completed.' },
        ],
      },
      {
        heading: 'Clients',
        items: [
          { title: 'Client list and history', body: 'Search clients, keep notes, and see visits, no-shows, and spend.' },
          { title: 'Rewards', body: 'Clients earn points or punches for visits and redeem them at checkout.' },
          { title: 'Opt-outs respected', body: 'Clients who reply STOP do not get texts.' },
          { title: 'Switch from another system', body: 'Import clients, services, team, and appointments from a CSV, with a preview and a start date for reminders.' },
        ],
      },
      {
        heading: 'Forms and messages',
        items: [
          { title: 'Online forms and waivers', body: 'Build intake forms and waivers, send them to clients, and review what they signed.' },
          { title: 'Form import', body: 'Upload a Word or PDF form, and Happli turns it into an online form for you to review before you save it.' },
          { title: 'Automatic messages', body: 'Booking confirmed, reminders, moved or canceled, thank-you after the visit, and time to come back.' },
          { title: 'Text, email, or both', body: 'Choose the channel for each message. Quiet hours hold reminder texts until your window opens.' },
          { title: 'Edit the wording', body: "Preview a message, send yourself a test, or go back to Happli's wording. Add custom messages such as prep instructions." },
          { title: 'Messages you approve', body: 'Personal notes, gap offers, and on-my-way texts send only after you approve them.' },
          { title: 'Waitlist and gap offers', body: 'Add clients to a waitlist, optionally let them join from the booking page, and send a gap-offer text you approve first.' },
        ],
      },
      {
        heading: 'Reports and marketing',
        items: [
          { title: 'Studio reports', body: 'Money collected, tips, deposits, no-show fees, package and gift card sales, refunds, visits, and results by team, service, and location, with CSV export.' },
          { title: 'Product sales report', body: 'See retail product sales in Reports.' },
          { title: 'Client source and revenue by source', body: 'See where each client came from and which sources bring in the most revenue.' },
          { title: 'Ask your reports', body: 'Type a question on the Reports page and get an answer from your real numbers.' },
          { title: 'Review request texts', body: 'Happli drafts a short text asking happy clients for a Google review. It sends only after you approve it.' },
          { title: 'Google Business Profile connect', body: 'Connect your Google listing to Happli in a few clicks.' },
        ],
      },
      {
        heading: 'Team and studio',
        items: [
          { title: 'Locations', body: 'Studio or mobile locations, each with its own booking page.' },
          { title: 'Team', body: 'Who works where, which services each person offers, and their hours.' },
          { title: 'Profile and brand voice', body: 'Your business details and how your studio sounds, with a live preview.' },
          { title: 'Quick search', body: 'Jump to any setting with Cmd+K on Mac or Ctrl+K on Windows.' },
        ],
      },
    ],
  },
  {
    id: 'progress',
    label: 'In progress',
    groups: [
      {
        items: [
          { title: 'Memberships', body: 'Monthly plans that bill automatically, with member perks at checkout. Turning on studio by studio.' },
          { title: 'Square payments', body: 'Use your own Square account for payments, starting with in-person card readers.' },
          { title: 'In-person card readers', body: 'Take card payments at the front desk with a card reader.' },
          { title: 'Approval for online bookings, service by service', body: 'Choose which services need your OK before an online booking is confirmed.' },
          { title: 'Website chat assistant', body: "A chat bubble for your website that answers questions from your studio's information and can capture leads. Early access; ask us to turn it on." },
        ],
      },
    ],
  },
  {
    id: 'later',
    label: 'Later',
    groups: [
      {
        items: [
          { title: 'Referrals', body: 'Reward clients who bring in friends.' },
          { title: 'AI COO chat', body: 'Ask about your business and get a simple plan for the day.' },
          { title: 'A texting number for each studio', body: 'Your own number for client texts, so replies come straight to you.' },
          { title: 'Edit your website in Happli', body: 'Update your studio site from the same place you run your day.' },
        ],
      },
    ],
  },
];
const mailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent('Feature suggestion')}`;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbs([{ name: 'Home', href: '/' }, { name: 'Roadmap', href: '/roadmap/' }])]}
>
  <PageIntro
    eyebrow="Roadmap"
    title="What we're building."
    lede="What's live, what's in progress and what's later. Tell us what would help your studio most."
    cta={false}
  />
  <div class="wrap">
    <div class="cols">
      {
        columns.map((c) => (
          <section class="col" aria-labelledby={`rm-${c.id}`}>
            <h2 id={`rm-${c.id}`}><span class:list={['dot', c.id]} aria-hidden="true"></span>{c.label}</h2>
            {(c.collapse ? c.groups.slice(0, 1) : c.groups).map((g) => {
              // Under a group heading (h3) the card titles are h4; otherwise they're h3.
              const Title = g.heading ? 'h4' : 'h3';
              return (
                <>
                  {g.heading && <h3 class="group">{g.heading}</h3>}
                  <ul>
                    {g.items.map((i) => (
                      <li>
                        <Title class="card-title">{i.title}</Title>
                        <p>{i.body}</p>
                      </li>
                    ))}
                  </ul>
                </>
              );
            })}
            {c.collapse && (
              <details class="more">
                <summary>
                  {/* A faded preview of the next group; the real cards are below, so screen readers skip it. */}
                  <div class="peek" aria-hidden="true">
                    <p class="group">{c.groups[1].heading}</p>
                    <div class="peek-card">
                      <p class="card-title">{c.groups[1].items[0].title}</p>
                      <p>{c.groups[1].items[0].body}</p>
                    </div>
                  </div>
                  <span class="btn btn-ghost">
                    <span class="when-closed">Show all {c.groups.reduce((n, g) => n + g.items.length, 0)} live features</span>
                    <span class="when-open">Show fewer</span>
                  </span>
                </summary>
                {c.groups.slice(1).map((g) => (
                  <>
                    <h3 class="group">{g.heading}</h3>
                    <ul>
                      {g.items.map((i) => (
                        <li>
                          <h4 class="card-title">{i.title}</h4>
                          <p>{i.body}</p>
                        </li>
                      ))}
                    </ul>
                  </>
                ))}
              </details>
            )}
          </section>
        ))
      }
    </div>
    <div class="foot">
      <a class="btn btn-coral" href={mailto}>Suggest a feature</a>
      <p class="note">Plans can change. Studios on launch pricing get early access.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .cols {
    margin-top: var(--space-block);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
  }
  .col {
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--blush-2);
    border: 1px solid var(--line);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 28px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--coral);
  }
  .dot.live {
    background: var(--ap-sage-edge);
  }
  .dot.later {
    background: var(--ap-sand-edge);
  }
  .group {
    margin-top: 28px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .group + ul {
    margin-top: 12px;
  }
  /* Live: the rest of the groups open from a button under a faded preview */
  .more summary {
    display: block;
    list-style: none;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .peek {
    position: relative;
    max-height: 150px;
    overflow: hidden;
  }
  .peek::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(251, 241, 236, 0), var(--blush-2) 80%);
  }
  .peek-card {
    margin-top: 12px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .more summary .btn {
    margin-top: 4px;
    width: 100%;
  }
  .more[open] .peek,
  .more[open] .when-closed,
  .more:not([open]) .when-open {
    display: none;
  }
  .more[open] summary .btn {
    margin-top: 16px;
  }
  ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  li {
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card-title {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
  }
  li p,
  .peek-card p:not(.card-title) {
    margin-top: 6px;
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .foot .btn {
    font-size: 16px;
  }
  .foot {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .note {
    font-size: 16px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .col {
      padding: 20px 16px;
    }
  }
</style>
