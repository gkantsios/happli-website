---
// The roadmap as a three-column board: In progress, Planned, and Shipped folded by area in native
// <details>. Every word comes from src/data/roadmap-copy.md (Grant's final copy);
// worker/test/roadmap-copy.test.ts checks the built page against it. No script on this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import { breadcrumbs } from '../lib/jsonld';
import { isoMonth, parseRoadmap } from '../lib/roadmap';
import { site } from '../config/site';
import copy from '../data/roadmap-copy.md?raw';

const title = 'Roadmap | What we are building next at Happli';
const description = "What's happening at Happli: what's in progress, what's planned and what's shipped. Suggest a feature anytime.";

const { intro, columns, shipped } = parseRoadmap(copy);
const mailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent('Feature suggestion')}`;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbs([{ name: 'Home', href: '/' }, { name: 'Roadmap', href: '/roadmap/' }])]}
>
  <PageIntro
    eyebrow="Roadmap"
    title="What we're building."
    lede="A quick look at what's on the way. Tell us what would help your studio most."
    cta={false}
  />
  <div class="wrap" data-roadmap>
    <p class="key">{intro}</p>
    <div class="board">
      {
        columns.map((c) => (
          <section class:list={['col', c.id]} aria-labelledby={`rm-${c.id}`}>
            <div class="col-head">
              <span class="dot" aria-hidden="true" />
              <h2 id={`rm-${c.id}`}>{c.label}</h2>
              <span class="count" aria-hidden="true" data-count>{c.notes.length}</span>
            </div>
            <ul class="cards">
              {c.notes.map((n) => (
                <li class="card">
                  <p class="card-title">{n.title}</p>
                  <p class="card-line">{n.line}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <section class="col shipped" aria-labelledby="rm-shipped">
        <div class="col-head">
          <span class="dot" aria-hidden="true" />
          <h2 id="rm-shipped">Shipped</h2>
          <span class="count" aria-hidden="true" data-count>{shipped.reduce((n, a) => n + a.notes.length, 0)}</span>
        </div>
        <div class="areas">
          {
            shipped.map((a) => (
              <details class="area">
                <summary>
                  <span class="area-name">{a.label}</span>
                  <span class="count" aria-hidden="true" data-count>{a.notes.length}</span>
                </summary>
                <ul class="done">
                  {a.notes.map((n) => {
                    const iso = isoMonth(n.when);
                    return (
                      <li>
                        <span class="what">{n.text}</span>
                        {iso ? <time class="when" datetime={iso}>{n.when}</time> : <span class="when">{n.when}</span>}
                      </li>
                    );
                  })}
                </ul>
              </details>
            ))
          }
        </div>
      </section>
    </div>

    <div class="foot">
      <a class="btn btn-coral" href={mailto}>Suggest a feature</a>
      <p class="note-foot">Plans can change. Studios on launch pricing get early access.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .key {
    margin-top: var(--space-block);
    max-width: 44em;
    font-size: 16px;
    color: var(--ink-2);
  }
  /* Three columns, two below 1000px (Shipped full width under the other two), one on phones. */
  .board {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }
  /* Each column's color: In progress coral, Planned the body gray, Shipped muted. Every text color is AA on
     --bg (coral-ink 5.7:1, ink-2 9:1, muted 5.4:1). */
  .in-progress {
    --dot: var(--coral);
    --label: var(--coral-ink);
  }
  .planned {
    --dot: var(--ink-2);
    --label: var(--ink-2);
  }
  .shipped {
    --dot: var(--muted);
    --label: var(--muted);
  }
  .col {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .col-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
  }
  .col-head h2 {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--label);
  }
  .count {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .cards {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .card {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .in-progress .card {
    box-shadow: inset 3px 0 0 var(--coral);
  }
  .card-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink);
  }
  .card-line {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .areas {
    margin-top: 8px;
  }
  .area + .area {
    border-top: 1px solid var(--line-strong);
  }
  .area summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 4px 4px 4px 0;
    list-style: none;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }
  .area summary::-webkit-details-marker {
    display: none;
  }
  .area-name {
    flex: 1;
  }
  /* A CSS chevron that points down when closed and up when open. */
  .area summary::after {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    margin: 0 6px 4px 4px;
    border-right: 2px solid var(--ink-2);
    border-bottom: 2px solid var(--ink-2);
    transform: rotate(45deg);
  }
  .area[open] summary::after {
    margin-bottom: -4px;
    transform: rotate(-135deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .area summary::after {
      transition: transform 0.2s var(--ease-out);
    }
  }
  .done {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .done li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 16px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .what {
    flex: 1 1 14em;
  }
  .when {
    flex: none;
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }

  .foot {
    margin-top: 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .foot .btn {
    min-height: 44px;
    font-size: 16px;
  }
  .note-foot {
    font-size: 16px;
    color: var(--muted);
  }

  @media (max-width: 999.98px) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shipped {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 699.98px) {
    .board {
      grid-template-columns: minmax(0, 1fr);
    }
    .col {
      padding: 16px;
    }
  }
</style>
