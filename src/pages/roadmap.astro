---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/sections/PageIntro.astro';
import { breadcrumbs } from '../lib/jsonld';
import { site } from '../config/site';

const title = 'Roadmap | What we are building next at Happli';
const description = "What's coming to Happli: what we're building now, what's next and what's later. Suggest a feature anytime.";

const columns = [
  {
    id: 'now',
    label: 'Now',
    items: [
      { title: 'Booking on your own website', body: 'Clients book in a window right on your site, without leaving it.' },
      { title: 'Deposits with Apple Pay and Google Pay', body: 'Clients pay their deposit in a tap, right on the booking page.' },
      { title: 'Google Business Profile connect', body: 'Connect your Google listing to Happli in a few clicks.' },
    ],
  },
  {
    id: 'next',
    label: 'Next',
    items: [
      { title: 'Memberships', body: 'Monthly plans that bill automatically and keep regulars coming back.' },
      { title: 'Rewards and referrals', body: 'Thank loyal clients and reward the ones who bring friends.' },
      { title: 'Square payments', body: "Take payments through Square if that's what you already use." },
    ],
  },
  {
    id: 'later',
    label: 'Later',
    items: [
      { title: 'AI COO chat', body: 'Ask about your business and get a simple plan for the day.' },
      { title: 'A texting number for each studio', body: 'Your own number for client texts, so replies come straight to you.' },
      { title: 'Edit your website in Happli', body: 'Update your studio site from the same place you run your day.' },
    ],
  },
];
const mailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent('Feature suggestion')}`;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[breadcrumbs([{ name: 'Home', href: '/' }, { name: 'Roadmap', href: '/roadmap/' }])]}
>
  <PageIntro
    eyebrow="Roadmap"
    title="What we're building."
    lede="A quick look at what's on the way. Tell us what would help your studio most."
    cta={false}
  />
  <div class="wrap">
    <div class="cols">
      {
        columns.map((c) => (
          <section class="col" aria-labelledby={`rm-${c.id}`}>
            <h2 id={`rm-${c.id}`}><span class:list={['dot', c.id]} aria-hidden="true"></span>{c.label}</h2>
            <ul>
              {c.items.map((i) => (
                <li>
                  <h3>{i.title}</h3>
                  <p>{i.body}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <div class="foot">
      <a class="btn btn-coral" href={mailto}>Suggest a feature</a>
      <p class="note">Plans can change. Studios on launch pricing get early access.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .cols {
    margin-top: var(--space-block);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .col {
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--blush-2);
    border: 1px solid var(--line);
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 28px;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--coral);
  }
  .dot.next {
    background: var(--ap-sand-edge);
  }
  .dot.later {
    background: var(--ap-sage-edge);
  }
  ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  li {
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  h3 {
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
  }
  li p {
    margin-top: 6px;
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .foot .btn {
    font-size: 16px;
  }
  .foot {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }
  .note {
    font-size: 16px;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .col {
      padding: 20px 16px;
    }
  }
</style>
